--- compound.c.orig
+++ compound.c
@@ -226,9 +226,16 @@
 #define FREE_FN b3Free
 #include "verstable.h"
 
+// b3SurfaceMaterial has trailing padding after customColor (the last field).
+// GCC does not guarantee padding bytes are copied on struct assignment, so
+// memcmp/hash over sizeof() would compare indeterminate bytes and fail to
+// deduplicate structurally identical materials.  Use only the meaningful bytes.
+#define B3_SURFACE_MATERIAL_BYTES \
+	( offsetof( b3SurfaceMaterial, customColor ) + sizeof( ( (b3SurfaceMaterial*)0 )->customColor ) )
+
 static inline uint64_t b3HashMaterial( const b3SurfaceMaterial* material )
 {
-	return vt_wyhash( material, sizeof( b3SurfaceMaterial ) );
+	return vt_wyhash( material, B3_SURFACE_MATERIAL_BYTES );
 }
 
 static bool b3CompareMaterials( const b3SurfaceMaterial* mat1, const b3SurfaceMaterial* mat2 )
@@ -238,8 +245,7 @@
 		return true;
 	}
 
-	int result = memcmp( mat1, mat2, sizeof( b3SurfaceMaterial ) );
-	return result == 0;
+	return memcmp( mat1, mat2, B3_SURFACE_MATERIAL_BYTES ) == 0;
 }
 
 #define NAME b3MaterialMap
